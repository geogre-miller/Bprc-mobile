{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bprc.local/agents/stitch-manifest.schema.json",
  "title": "StitchSourceManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "projectId", "screenId", "retrievedAt", "sourceFingerprint", "screenshot", "assets"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "artifactType": { "const": "StitchSourceManifest" },
    "projectId": { "type": "string", "minLength": 1 },
    "screenId": { "type": "string", "minLength": 1 },
    "retrievedAt": { "type": "string" },
    "sourceFingerprint": { "type": "string", "minLength": 16 },
    "screenshot": { "$ref": "#/$defs/fileEvidence" },
    "html": { "anyOf": [{ "$ref": "#/$defs/fileEvidence" }, { "type": "null" }] },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/fileEvidence" } }
  },
  "$defs": {
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "sourceUrl": { "type": ["string", "null"] }
      }
    }
  }
}
