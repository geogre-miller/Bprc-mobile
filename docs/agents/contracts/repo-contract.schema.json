{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bprc.local/agents/repo-contract.schema.json",
  "title": "RepoContract",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "artifactType", "screenOwner", "repository", "reuse", "writeScope", "risk", "checks"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "artifactType": { "const": "RepoContract" },
    "generatedAt": { "type": "string" },
    "route": { "type": ["string", "null"] },
    "screenOwner": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "dependencies"],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 16 },
        "dependencies": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "architecture": { "type": "object" },
    "layout": { "type": "object" },
    "reuse": { "type": "array", "items": { "type": "string" } },
    "patterns": { "type": "object" },
    "sharedEdits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["exclusive", "additive"] },
          "registry": { "type": ["string", "null"] }
        }
      }
    },
    "writeScope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "forbiddenScope": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "risk": { "enum": ["low", "medium", "high", "critical", "unknown"] },
    "riskReason": { "type": ["string", "null"] },
    "riskResolved": { "type": "boolean" }
  }
}
